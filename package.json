{
  "name": "my-cypress-project",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "cypress install",
    "cypress:open": "env -u ELECTRON_RUN_AS_NODE cypress open",
    "cypress:run": "env -u ELECTRON_RUN_AS_NODE cypress run",
    "cypress:run:chrome": "env -u ELECTRON_RUN_AS_NODE cypress run --browser chrome",
    "cypress:run:firefox": "env -u ELECTRON_RUN_AS_NODE cypress run --browser firefox",
    "cypress:run:edge": "env -u ELECTRON_RUN_AS_NODE cypress run --browser edge",
    "test": "env -u ELECTRON_RUN_AS_NODE cypress run",
    "practice:check": "tsc -p typescript-practice/tsconfig.json",
    "practice:hints-off": "node scripts/toggle-practice-intellisense.mjs off",
    "practice:hints-on": "node scripts/toggle-practice-intellisense.mjs on"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.5.2",
    "cypress": "^15.4.0",
    "cypress-image-diff-js": "^2.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "cypress-real-events": "^1.15.0"
  }
}
